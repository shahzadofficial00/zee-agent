{
  "$id": "https://jaino.com/dsl/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jaino DSL Event Schema",
  "description": "Single source of truth for all com.jaino.dsl events",
  "type": "object",
  "required": ["v", "type", "data"],
  "properties": {
    "v": {
      "type": "integer",
       "enum": [1, 2, 3],
      "description": "DSL version"
    },
    "type": {
      "type": "string",
      "enum": ["menu", "payment", "appointment", "order_history", "menu_item", "menu_category", "order_confirmation", "banner", "poll", "poll_response", "poll_history", "poll_results", "tip_request", "auction", "auction_result", "fulfillment_method", "fulfillment_selection", "name_request", "name_response", "car_request", "car_response", "address_request", "address_response", "order_status", "terms", "terms_response", "terms_history"],
      "description": "DSL event type"
    },
    "data": {
      "type": "object",
      "description": "Payload — shape depends on type"
    }
  },

  "allOf": [
    {
      "if": { "properties": { "type": { "const": "menu" }, "v": { "const": 1 } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/menu_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "menu" }, "v": { "const": 2 } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/menu_data_v2" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "payment" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/payment_data" }
        }
      }
    },
   {
      "if": { "properties": { "type": { "const": "appointment" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/appointment_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "order_history" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/order_history_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "menu_item" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/menu_item_card_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "menu_category" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/menu_category_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "order_confirmation" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/order_confirmation_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "banner" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/banner_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "poll" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/poll_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "poll_history" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/poll_history_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "poll_results" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/poll_results_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tip_request" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/tip_request_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "auction" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/auction_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "auction_result" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/auction_result_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "fulfillment_method" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/fulfillment_method_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "name_request" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/name_request_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "car_request" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/car_request_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "address_request" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/address_request_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "order_status" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/order_status_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "terms" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/terms_data" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "terms_history" } } },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/terms_history_data" }
        }
      }
    }
  ],

  "$defs": {

    "menu_data": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/menu_item" }
        }
      }
    },

    "menu_item": {
      "type": "object",
      "required": ["name", "price"],
      "properties": {
        "id":        { "type": "string" },
        "name":      { "type": "string" },
        "price":     { "type": "string", "description": "Matches menu_item_card_data's convention — the generated Dart model types this as a non-nullable String." },
        "image":     { "type": "string" },
        "description": { "type": "string" },
        "orderable": { "type": "boolean" },
        "rating":    { "type": "string", "description": "Aggregate average score, e.g. \"4.6\". Omitted/empty = no stars." },
        "reviews":   { "type": "integer", "description": "Number of ratings behind the average." }
      }
    },

    "menu_data_v2": {
      "type": "object",
      "required": ["title", "categories"],
      "properties": {
        "title":     { "type": "string" },
        "banner":    { "type": "string" },
        "orderable": { "type": "boolean" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "items"],
            "properties": {
              "name":  { "type": "string" },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/menu_item" }
              }
            }
          }
        }
      }
    },

    "payment_data": {
  "type": "object",
  "required": ["amount", "currency", "order_id", "payment_url", "customer_name"],
  "properties": {
    "amount":         { "type": "number", "minimum": 10 },
    "currency":       { "type": "string", "enum": ["PKR"] },
    "order_id":       { "type": "string" },
    "transaction_id": { "type": "string" },
    "payment_url":    { "type": "string", "format": "uri" },
    "customer_name":  { "type": "string" },
    "business_name":  { "type": "string" },
    "created_at":     { "type": "string" }
  }
},

    "appointment_data": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" }
      }
    },

    "order_history_data": {
      "type": "object",
      "required": ["orders"],
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id":           { "type": "integer" },
              "customer_name":{ "type": "string" },
              "items":        { "type": "string" },
              "total_amount": { "type": "number" },
              "status":       { "type": "string" },
              "created_at":   { "type": "string" }
            }
          }
        }
      }
    },

    "menu_item_card_data": {
      "type": "object",
      "required": ["name", "price"],
      "properties": {
        "name":        { "type": "string" },
        "price":       { "type": "string" },
        "image":       { "type": "string" },
        "description": { "type": "string" },
        "rating":      { "type": "string", "description": "Aggregate average score, e.g. \"4.6\". Omitted/empty = no stars." },
        "reviews":     { "type": "integer", "description": "Number of ratings behind the average." }
      }
    },

    "menu_category_data": {
      "type": "object",
      "required": ["name", "items"],
      "properties": {
        "name":   { "type": "string" },
        "banner": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/menu_item" }
        }
      }
    },

    "order_confirmation_data": {
      "type": "object",
      "required": ["items", "total_amount", "customer_name"],
      "properties": {
        "order_id":        { "type": "string" },
        "customer_name":   { "type": "string" },
        "location":        { "type": "string" },
        "created_at":      { "type": "string" },
        "raw_order_text":  { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "qty", "price"],
            "properties": {
              "name":  { "type": "string" },
              "qty":   { "type": "integer" },
              "price": { "type": "number" },
              "image": { "type": "string" }
            }
          }
        },
        "total_amount":  { "type": "number", "minimum": 10 },
        "currency":      { "type": "string", "enum": ["PKR"] },
        "fulfillment": {
          "type": "object",
          "description": "v2 only — omitted on v1 payloads",
          "properties": {
            "method":  { "type": "string", "enum": ["dine_in", "pickup", "car", "delivery"] },
            "summary": { "type": "string" }
          }
        }
      }
    },

    "fulfillment_method_data": {
      "type": "object",
      "required": ["order_id"],
      "properties": {
        "order_id": { "type": "string" },
        "title":    { "type": "string" },
        "message":  { "type": "string" }
      }
    },

    "name_request_data": {
      "type": "object",
      "required": ["order_id", "method"],
      "properties": {
        "order_id": { "type": "string" },
        "method":   { "type": "string", "enum": ["dine_in", "pickup"] },
        "title":    { "type": "string" }
      }
    },

    "car_request_data": {
      "type": "object",
      "required": ["order_id"],
      "properties": {
        "order_id": { "type": "string" },
        "title":    { "type": "string" },
        "message":  { "type": "string" }
      }
    },

    "address_request_data": {
      "type": "object",
      "required": ["order_id"],
      "properties": {
        "order_id": { "type": "string" },
        "title":    { "type": "string" },
        "message":  { "type": "string" }
      }
    },

    "order_status_data": {
      "type": "object",
      "required": ["order_id", "status"],
      "properties": {
        "order_id": { "type": "string" },
        "status":   { "type": "string" },
        "message":  { "type": "string" }
      }
    },

    "banner_data": {
      "type": "object",
      "required": ["variant"],
      "properties": {
        "variant": { "type": "string", "enum": ["info", "warning", "success", "outage", "critical"] },
        "title":   { "type": "string" },
        "message": { "type": "string" },
        "meta":    { "type": "string" }
      }
    },
"poll_data": {
      "type": "object",
      "required": ["poll_id", "question", "poll_type"],
      "properties": {
        "poll_id":      { "type": "string" },
        "chain_id":     { "type": "string" },
        "question":     { "type": "string" },
        "poll_type":    { 
          "type": "string", 
          "enum": ["single_choice", "multi_select", "yes_no", "rating", "open_text", "ranking"]
        },
        "options":      { "type": "array", "items": { "type": "string" } },
        "allow_multiple": { "type": "boolean" },
        "rating_style": { "type": "string", "enum": ["stars", "nps", "emoji"] },
        "rating_max":   { "type": "integer" },
        "submitted":    { "type": "boolean" },
        "selected":     {}
      }
    },
    
  "poll_history_data": {
      "type": "object",
      "required": ["answers", "total"],
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "answer":   { "type": "string" },
              "poll_type": { "type": "string" },
              "created_at": { "type": "string" }
            }
          }
        },
        "total": { "type": "integer" }
      }
    },

    "poll_results_data": {
      "type": "object",
      "required": ["question", "poll_type"],
      "properties": {
        "question":      { "type": "string" },
        "poll_type":     { "type": "string" },
        "menu_item":     { "type": "string" },
        "average_x10":   { "type": "integer", "description": "Average rating x10 as a plain int (e.g. 45 = 4.5) — Matrix's canonical JSON forbids raw floats in event content." },
        "total_votes":   { "type": "integer" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option", "count", "percent"],
            "properties": {
              "option":  { "type": "string" },
              "count":   { "type": "integer" },
              "percent": { "type": "integer", "description": "Rounded whole-number percentage — must stay an integer, not a float, for the same Matrix JSON reason as average_x10." }
            }
          }
        }
      }
    },

    "tip_request_data": {
      "type": "object",
      "required": ["tip_id", "title"],
      "properties": {
        "tip_id":         { "type": "string" },
        "title":          { "type": "string" },
        "message":        { "type": "string" },
        "recipient_name": { "type": "string" },
        "currency":       { "type": "string" },
        "presets": {
          "type": "array",
          "items": {}
        },
        "allow_custom":   { "type": "boolean" },
        "allow_decline":  { "type": "boolean" }
      }
    },

    "auction_data": {
      "type": "object",
      "required": ["auction_id", "title", "starting_price", "ends_at"],
      "properties": {
        "auction_id":     { "type": "string" },
        "title":          { "type": "string" },
        "image":          { "type": "string" },
        "currency":       { "type": "string" },
        "starting_price": { "type": "number" },
        "min_bid":        { "type": "number" },
        "ends_at":        { "type": "string" }
      }
    },

    "auction_result_data": {
      "type": "object",
      "required": ["title", "winning_amount", "is_winner"],
      "properties": {
        "title":          { "type": "string" },
        "currency":       { "type": "string" },
        "winning_amount": { "type": "number" },
        "is_winner":      { "type": "boolean" },
        "order_id":       { "type": "string" },
        "user_id":        { "type": "string" }
      }
    },

    "terms_data": {
      "type": "object",
      "required": ["terms_id", "version", "title", "body", "signing_level"],
      "properties": {
        "terms_id":       { "type": "string" },
        "version":        { "type": "string" },
        "title":          { "type": "string" },
        "body":           { "type": "string" },
        "signing_level":  { "type": "string", "enum": ["tap", "typed", "drawn"] },
        "allow_decline":  { "type": "boolean" }
      }
    },

    "terms_history_data": {
      "type": "object",
      "required": ["agreements"],
      "properties": {
        "agreements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "version", "agreed", "method"],
            "properties": {
              "title":     { "type": "string" },
              "version":   { "type": "string" },
              "agreed":    { "type": "boolean" },
              "method":    { "type": "string", "enum": ["tap", "typed", "drawn"] },
              "signed_at": { "type": "string" },
              "body":      { "type": "string" }
            }
          }
        }
      }
    }

  }
}